# Linear API Key（从 https://linear.app/johnsince2019/settings/api 获取）
LINEAR_API_KEY=lin_api_your_key_here

# PostgreSQL connection for Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_ops?schema=public

# Redis connection for BullMQ
REDIS_URL=redis://127.0.0.1:6379

# LLM Gateway image generation endpoint
LLM_GATEWAY_BASE_URL=http://127.0.0.1:3000
VIDEO_OPS_IMAGE_MODEL=gpt-image-2
VIDEO_OPS_BROLL_MODEL=wanx-v1

# Local TTS (CosyVoice 3.0 MLX)
VIDEO_OPS_TTS_MODEL=aufklarer/CosyVoice3-0.5B-MLX-4bit
VIDEO_OPS_TTS_PYTHON=python
VIDEO_OPS_TTS_OUTPUT_DIR=assets/audio
VIDEO_OPS_TTS_REFERENCE_DIR=assets/reference-audio
